---
// Detail page for a holding. A page is built for every holding in site.json that has a "detail" block
// (only holding-01 for now). Copy that block onto another holding to give it a page too.
import Base from '../../layouts/Base.astro';
import Label from '../../components/Label.astro';
import Img from '../../components/Img.astro';
import site from '../../content/site.json';

export function getStaticPaths() {
  return site.holdings.items
    .filter((h) => h.detail)
    .map((h) => ({ params: { slug: h.slug }, props: { holding: h } }));
}
const { holding } = Astro.props;
const { detail } = holding;
---
<Base title={holding.name} description={holding.description}>
  <div class="reveal">
    <Img image={detail.heroImage} shape="hero" eager />
  </div>
  <section class="section">
    <div class="container detail">
      <div class="detail__main reveal">
        <Label text={site.holdings.label} />
        <h1 class="h-lg">{holding.name}</h1>
        <p class="lead">{holding.description}</p>
        <p class="body">{detail.body}</p>
      </div>
      <aside class="detail__side reveal">
        <img class="detail__logo" src={holding.logo.src} alt={holding.logo.alt} width="320" height="120" />
        <h2 class="label">{detail.factsHeading}</h2>
        <dl class="facts">
          {detail.facts.map((fact) => (
            <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
          ))}
        </dl>
        <a class="text-link" href={detail.website.href} rel="noopener">{detail.website.label}</a>
        <a class="small" href={detail.back.href}>{detail.back.label}</a>
      </aside>
    </div>
  </section>
</Base>
