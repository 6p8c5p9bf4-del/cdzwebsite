---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import HoldingsWall from '../../components/HoldingsWall.astro';
import site from '../../content/site.json';
const { holdings } = site;
---
<Base title={holdings.title}>
  <PageHead label={holdings.label} heading={holdings.heading} intro={holdings.intro} />
  <section class="section section--tight-top">
    <div class="container">
      <HoldingsWall items={holdings.items} />
    </div>
  </section>
</Base>
