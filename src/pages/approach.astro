---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Split from '../components/Split.astro';
import site from '../content/site.json';
const { approach } = site;
const number = (i) => String(i + 1).padStart(2, '0');
---
<Base title={approach.title}>
  <PageHead label={approach.label} heading={approach.heading} intro={approach.intro} />
  <section class="section section--tight-top">
    <div class="container">
      {approach.principles.map((p, i) => (
        <Split number={number(i)} heading={p.name} body={p.body} image={p.image} reverse={i % 2 === 1} />
      ))}
    </div>
  </section>
</Base>
