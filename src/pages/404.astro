---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import site from '../content/site.json';
const { notFound } = site;
---
<Base title={notFound.title}>
  <PageHead label={notFound.label} heading={notFound.heading} />
  <section class="section section--tight-top">
    <div class="container">
      <a class="text-link" href={notFound.link.href}>{notFound.link.label}</a>
    </div>
  </section>
</Base>
