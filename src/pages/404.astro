---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
---
<Base title="Page not found">
  <section class="page-top section" style="padding-bottom: var(--space-section)">
    <div class="container">
      <Label text="404" />
      <h1 class="h-large">This page could not be <em>found</em></h1>
      <p style="margin-top: 32px"><a class="text-link" href="/">Back to home</a></p>
    </div>
  </section>
</Base>
