---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import content from '../content/site.json';

const { press } = content;
---
<Base title={press.title}>
  <section class="page-top section" style="padding-bottom: var(--space-section)">
    <div class="container">
      <PageIntro label={press.label} heading={press.heading} intro={press.intro} />
      <ul class="rows reveal">
        {press.articles.map((article) => (
          <li class="row row--article">
            <h2 class="row__title">{article.title}</h2>
            <p class="row__meta">{article.outlet}</p>
            <p class="row__meta">{article.date}</p>
            <p>
              <a class="text-link" href={article.href} rel="noopener">
                {press.readLabel}<span class="visually-hidden">: {article.title}</span>
              </a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
