---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import Img from '../components/Img.astro';
import Split from '../components/Split.astro';
import HoldingsWall from '../components/HoldingsWall.astro';
import site from '../content/site.json';
import { em } from '../lib/format.js';

const { hero, about, approach, splits, holdings, press, closing } = site.home;
const wall = site.holdings.items.slice(0, holdings.count);
const articles = site.press.articles.slice(0, press.count);
---
<Base title={site.home.title} overHero>
  <!-- 2. Hero -->
  <section class="photo-section hero on-photo">
    <div class="photo-section__media hero__media">
      <img src={hero.image.src} alt={hero.image.alt} width={hero.image.width} height={hero.image.height} fetchpriority="high" />
    </div>
    <div class="photo-section__content">
      <h1 class="h-display">{hero.tagline}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
    </div>
    <a class="hero__scroll" href="#about">{hero.scroll}</a>
  </section>

  <!-- 3. About -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-head reveal">
        <Label text={about.label} />
        <h2 class="h-lg" set:html={em(about.heading)} />
      </div>
      <div class="about__images reveal">
        {about.images.map((image) => <Img image={image} shape="portrait" />)}
      </div>
      <div class="about__text reveal">
        <p class="lead">{about.body}</p>
        <a class="text-link" href={about.link.href}>{about.link.label}</a>
      </div>
    </div>
  </section>

  <!-- 4. Approach -->
  <section class="section section--tight-top">
    <div class="container">
      <div class="section-head section-head--split reveal">
        <Label text={approach.label} />
        <h2 class="h-lg" set:html={em(approach.heading)} />
        <div class="section-head__aside">
          <p class="body">{approach.intro}</p>
          <a class="text-link" href={approach.link.href}>{approach.link.label}</a>
        </div>
      </div>
      <Img class="reveal" image={approach.image} shape="wide" />
      <ul class="cards">
        {approach.cards.map((card) => (
          <li class="card reveal">
            <Img image={card.image} shape="tall" />
            <h3 class="h-sm">{card.name}</h3>
            <p class="small">{card.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Split blocks: Story, then Team reversed -->
  <section class="section section--tight-top">
    <div class="container">
      {splits.map((block, i) => <Split {...block} reverse={i % 2 === 1} />)}
    </div>
  </section>

  <!-- 6. Holdings: the off-grid wall -->
  <section class="section section--tight-top">
    <div class="container">
      <div class="section-head section-head--row reveal">
        <Label text={holdings.label} />
        <h2 class="h-lg" set:html={em(holdings.heading)} />
        <a class="text-link" href={holdings.link.href}>{holdings.link.label}<span class="visually-hidden"> holdings</span></a>
      </div>
      <HoldingsWall items={wall} />
    </div>
  </section>

  <!-- 7. Press -->
  <section class="section section--tight-top">
    <div class="container">
      <div class="section-head section-head--row reveal">
        <Label text={press.label} />
        <h2 class="h-lg" set:html={em(press.heading)} />
        <a class="text-link" href={press.link.href}>{press.link.label}<span class="visually-hidden"> press</span></a>
      </div>
      <ul class="rows reveal">
        {articles.map((article) => (
          <li class="row">
            <p class="row__title"><a href={article.href}>{article.title}</a></p>
            <p class="row__meta">{article.date}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. Closing -->
  <section class="photo-section closing on-photo">
    <div class="photo-section__media">
      <img src={closing.image.src} alt={closing.image.alt} width={closing.image.width} height={closing.image.height} loading="lazy" />
    </div>
    <div class="photo-section__content reveal">
      <h2 class="h-lg" set:html={em(closing.heading)} />
      <div class="closing__buttons">
        <a class="btn btn--paper" href={closing.buttons[0].href}>{closing.buttons[0].label}</a>
        <a class="btn btn--ghost" href={closing.buttons[1].href}>{closing.buttons[1].label}</a>
      </div>
    </div>
  </section>
</Base>
