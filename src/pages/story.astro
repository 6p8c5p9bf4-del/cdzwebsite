---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import Split from '../components/Split.astro';
import content from '../content/site.json';

const { story } = content;
---
<Base title={story.title}>
  <section class="page-top">
    <div class="container">
      <PageIntro label={story.label} heading={story.heading} intro={story.intro} />
    </div>
    <figure class="wide-image reveal"><Picture image={story.image} eager /></figure>
  </section>

  <section class="section">
    <div class="container">
      {story.sections.map((part, index) => <Split {...part} reverse={index % 2 === 1} />)}
    </div>
  </section>
</Base>
