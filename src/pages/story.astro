---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Img from '../components/Img.astro';
import Split from '../components/Split.astro';
import site from '../content/site.json';
const { story } = site;
---
<Base title={story.title}>
  <PageHead label={story.label} heading={story.heading} intro={story.intro} />
  <div class="container reveal">
    <Img image={story.image} shape="hero" eager />
  </div>
  <section class="section">
    <div class="container">
      {story.sections.map((part, i) => <Split {...part} reverse={i % 2 === 1} />)}
    </div>
  </section>
</Base>
