---
import site from '../content/site.json';
const { contact, footer } = site;
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" aria-label={`${site.site.name} home`}>
          <img src="/logos/wordmark-dark.svg" alt={site.site.name} width="416" height="64" loading="lazy" />
        </a>
        <address>
          <span>{contact.address}</span>
          <a href={`tel:${contact.phone}`}>{contact.phone}</a>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </address>
      </div>
      <nav aria-label="Footer">
        <h2 class="label">{footer.menuHeading}</h2>
        <ul>
          {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="label">{footer.socialHeading}</h2>
        <ul>
          {footer.social.map((item) => <li><a href={item.href} rel="noopener">{item.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>{footer.copyright}</span>
      <a href={footer.privacy.href}>{footer.privacy.label}</a>
    </div>
  </div>
</footer>
