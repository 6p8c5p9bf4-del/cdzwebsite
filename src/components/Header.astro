---
import content from '../content/site.json';

const { overHero = false } = Astro.props;
const { nav, site, contact } = content;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => (href === '/' ? current === '/' : current.startsWith(href));
const contactLink = nav.find((item) => item.href === '/contact');
const barLinks = nav.filter((item) => item.href !== '/contact');
---
<header class:list={['site-header', { 'site-header--over': overHero }]}>
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <img class="wordmark__dark" src="/logos/wordmark-dark.svg" alt="" width="400" height="64" />
      <img class="wordmark__light" src="/logos/wordmark-light.svg" alt="" width="400" height="64" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {barLinks.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      {contactLink && <a class="btn btn--small" href={contactLink.href}>{contactLink.label}</a>}
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-overlay"
      data-open={site.menuOpen}
      data-close={site.menuClose}
    >{site.menuOpen}</button>

    <div class="menu-overlay" id="menu-overlay" hidden>
      <nav aria-label="Main, mobile">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="small">{contact.email}<br />{contact.phone}</p>
    </div>
  </div>
</header>
