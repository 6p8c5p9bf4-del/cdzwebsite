---
import site from '../content/site.json';
const { overHero = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
const contact = site.nav.find((item) => item.href === '/contact');
---
<header class:list={['site-header', overHero && 'site-header--over']}>
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.site.name} home`}>
      <img class="wordmark--dark" src="/logos/wordmark-dark.svg" alt={site.site.name} width="416" height="64" />
      <img class="wordmark--light" src="/logos/wordmark-light.svg" alt={site.site.name} width="416" height="64" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      {contact && <a class="btn btn--small" href={contact.href}>{contact.label}</a>}
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open={site.site.menuOpen}
      data-close={site.site.menuClose}
    >{site.site.menuOpen}</button>

    <div class="mobile-menu" id="mobile-menu" hidden>
      <nav aria-label="Mobile">
        <ul>
          {site.nav.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="mobile-menu__foot">
        <span>{site.contact.email}</span>
        <span>{site.contact.phone}</span>
      </div>
    </div>
  </div>
</header>
