---
// The off-grid wall of holdings. Tile positions are set by the .pos-N rules in src/styles/global.css.
import Img from './Img.astro';
const { items } = Astro.props;
---
<ul class="wall">
  {items.map((h, i) => (
    <li class:list={['tile', `pos-${i + 1}`, 'reveal']}>
      {h.detail ? (
        <a class="tile__link" href={`/holdings/${h.slug}`}>
          <Img image={h.image} shape={h.shape} />
          <span class="tile__caption">
            <span class="tile__name">{h.name}</span>
            <span class="tile__desc">{h.description}</span>
          </span>
        </a>
      ) : (
        <div>
          <Img image={h.image} shape={h.shape} />
          <div class="tile__caption">
            <span class="tile__name">{h.name}</span>
            <span class="tile__desc">{h.description}</span>
          </div>
        </div>
      )}
    </li>
  ))}
</ul>
